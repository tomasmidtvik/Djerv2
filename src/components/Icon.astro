---
// Små ikoner som inline-SVG (ingen eksterne filer).
interface Props {
  name: 'hjem' | 'kamper' | 'spillere' | 'statistikk' | 'opptak' | 'sok' | 'sol' | 'maane' | 'ball' | 'play' | 'pil-venstre' | 'pil-hoyre' | 'fløyte' | 'kaptein';
  class?: string;
  label?: string;
}
const { name, class: cls = 'w-5 h-5', label } = Astro.props;
const a11y = label ? { role: 'img', 'aria-label': label } : { 'aria-hidden': 'true' };
---

<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class={cls} {...a11y}>
  {name === 'hjem' && <path d="M3 10.5 12 3l9 7.5V20a1 1 0 0 1-1 1h-5v-6h-6v6H4a1 1 0 0 1-1-1z" />}
  {name === 'kamper' && (
    <>
      <rect x="3" y="4.5" width="18" height="16" rx="2" />
      <path d="M3 9.5h18M8 2.5v4M16 2.5v4" />
    </>
  )}
  {name === 'spillere' && (
    <>
      <circle cx="9" cy="8" r="3.5" />
      <path d="M2.5 20c.6-3.6 3.2-5.5 6.5-5.5s5.9 1.9 6.5 5.5" />
      <path d="M16 4.6a3.5 3.5 0 0 1 0 6.8M18.5 14.8c1.7.7 2.8 2.4 3 5.2" />
    </>
  )}
  {name === 'statistikk' && <path d="M4 20V10M10 20V4M16 20v-7M22 20H2" />}
  {name === 'opptak' && (
    <>
      <rect x="2.5" y="5.5" width="14" height="13" rx="2" />
      <path d="m16.5 10 5-3v10l-5-3z" />
    </>
  )}
  {name === 'sok' && (
    <>
      <circle cx="11" cy="11" r="7" />
      <path d="m20 20-3.5-3.5" />
    </>
  )}
  {name === 'sol' && (
    <>
      <circle cx="12" cy="12" r="4" />
      <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
    </>
  )}
  {name === 'maane' && <path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5z" />}
  {name === 'ball' && (
    <>
      <circle cx="12" cy="12" r="9.5" />
      <path d="m12 7.5 3.6 2.6-1.4 4.2H9.8l-1.4-4.2z" fill="currentColor" stroke-width="1.2" />
      <path d="M12 7.5V2.6M15.6 10.1l4.5-1.6M14.2 14.3l2.8 3.9M9.8 14.3 7 18.2M8.4 10.1 3.9 8.5" stroke-width="1.4" />
    </>
  )}
  {name === 'play' && <path d="M8 5.5v13l11-6.5z" fill="currentColor" />}
  {name === 'pil-venstre' && <path d="M15 5l-7 7 7 7" />}
  {name === 'pil-hoyre' && <path d="m9 5 7 7-7 7" />}
  {name === 'fløyte' && (
    <>
      <circle cx="8" cy="15" r="5" />
      <path d="M11 11.5 21 7v4l-8 3.5M3 6l2 2M8 3v3" />
    </>
  )}
  {name === 'kaptein' && <path d="M12 3 4 6v6c0 4.5 3.4 8 8 9 4.6-1 8-4.5 8-9V6z" />}
</svg>
