---
import { hatTricks } from '../lib/analyse.ts';
import { datoKort, getDb, kampUrl, spillerUrl, tall } from '../lib/site.ts';
import { toppliste } from '../lib/stats.ts';
import StatSeksjon from './StatSeksjon.astro';
import Toppliste from './Toppliste.astro';
interface Props {
  sesong: number | null;
}
const { sesong } = Astro.props;
const db = getDb();
const p = db.personer;
const scorere = toppliste(p, 'mal', sesong);
const flestKamper = toppliste(p, 'kamper', sesong);
const gule = toppliste(p, 'gule', sesong);
const rode = toppliste(p, 'rode', sesong);
const hat = toppliste(p, 'hatTricks', sesong);
const supersub = toppliste(p, 'malInnbytter', sesong);
const hatListe = hatTricks(p, sesong);
---

<StatSeksjon seksjon="" tittel="Topplister" sesong={sesong} beskrivelse={`Toppscorere, kort og flest kamper for ${db.settings.lagnavn}.`}>
  <div class="grid gap-5 lg:grid-cols-2">
    <Toppliste
      id="toppscorere"
      tittel="Toppscorere"
      rader={scorere}
      tom="Ingen mål registrert."
      kolonner={[
        { label: 'Kamper', title: 'Kamper i troppen', verdi: (r) => r.stat.kamper },
        { label: 'Mål/kamp', verdi: (r) => tall(r.stat.mal / r.stat.kamper, 2) },
        { label: 'Mål', verdi: (r) => r.stat.mal, fet: true },
      ]}
    />
    <Toppliste
      id="flest-kamper"
      tittel="Flest kamper"
      rader={flestKamper}
      kolonner={[
        { label: 'Start', verdi: (r) => r.stat.startet },
        { label: 'Innb.', title: 'I troppen som innbytter', verdi: (r) => r.stat.innbytter },
        { label: 'Kamper', title: 'Kamper i troppen', verdi: (r) => r.stat.kamper, fet: true },
      ]}
      merknad="Kamper i troppen. Innbyttere er alltid krysset av som spilt, så vi vet ikke om alle kom inn."
    />
    <Toppliste
      id="hat-tricks"
      tittel="Flest hat-tricks"
      rader={hat}
      tom="Ingen hat-tricks."
      kolonner={[
        { label: 'Mål', verdi: (r) => r.stat.mal },
        { label: 'Hat-tricks', verdi: (r) => r.stat.hatTricks, fet: true },
      ]}
    />
    <Toppliste
      id="innbyttere"
      tittel="Mål som innbytter"
      rader={supersub}
      tom="Ingen mål av innbyttere."
      kolonner={[
        { label: 'Innb.', title: 'Kamper som innbytter', verdi: (r) => r.stat.innbytter },
        { label: 'Mål', verdi: (r) => r.stat.malInnbytter, fet: true },
      ]}
    />
    <Toppliste
      id="gule"
      tittel="Flest gule kort"
      rader={gule}
      tom="Ingen gule kort."
      kolonner={[
        { label: 'Kamper', verdi: (r) => r.stat.kamper },
        { label: 'Gule', verdi: (r) => r.stat.gule, fet: true },
      ]}
    />
    <Toppliste
      id="rode"
      tittel="Flest røde kort"
      rader={rode}
      tom="Ingen røde kort."
      kolonner={[
        { label: '2 gule', title: 'Rødt etter to gule (Utv. Adv. 2)', verdi: (r) => r.stat.rodeAdv2 },
        { label: 'Direkte', title: 'Direkte rødt (Utv. Direkte)', verdi: (r) => r.stat.rodeDirekte },
        { label: 'Totalt', verdi: (r) => r.stat.rode, fet: true },
      ]}
    />
  </div>

  {
    hatListe.length > 0 && (
      <section aria-labelledby="hat-liste">
        <h2 id="hat-liste" class="h-section mb-2">Alle hat-tricks</h2>
        <ul class="card divide-y divide-line">
          {hatListe.map((h) => (
            <li class="flex flex-wrap items-baseline justify-between gap-x-3 px-4 py-2 text-sm">
              <a class="link font-medium" href={spillerUrl(h.person.slug)}>{h.person.navn} <span class="num text-muted">({h.antall} mål)</span></a>
              <a class="link text-xs" href={kampUrl(h.kamp.kampnr)}>Mot {h.kamp.motstander}, {datoKort(h.kamp.dato)}</a>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</StatSeksjon>
