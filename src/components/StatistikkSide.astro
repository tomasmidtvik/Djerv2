---
import Layout from '../layouts/Layout.astro';
import { getDb, prosent, tall, url } from '../lib/site.ts';
import { kamperISesong, lagStat, toppliste } from '../lib/stats.ts';
import Toppliste from './Toppliste.astro';
interface Props {
  sesong: number | null;
}
const { sesong } = Astro.props;
const db = getDb();
const poeng = db.settings.poeng;
const kamper = kamperISesong(db, sesong);
const lag = lagStat(kamper, poeng);
const sesongRader = db.sesonger.map((s) => ({ s, st: lagStat(kamperISesong(db, s), poeng) }));
const p = db.personer;
const scorere = toppliste(p, 'mal', sesong);
const flestKamper = toppliste(p, 'kamper', sesong);
const gule = toppliste(p, 'gule', sesong);
const rode = toppliste(p, 'rode', sesong);
const minKamper = sesong ? 1 : 3;
const disiplin = toppliste(p, 'kortPerKamp', sesong, minKamper);
const tittel = sesong ? `Statistikk ${sesong}` : 'Statistikk – alle tider';
---

<Layout title={tittel} description={`Toppscorere, kort og flest kamper for ${db.settings.lagnavn}${sesong ? ` i ${sesong}` : ''}.`} aktiv="statistikk">
  <h1 class="text-2xl font-bold tracking-tight">{tittel}</h1>

  <nav class="mt-3 overflow-x-auto" aria-label="Velg sesong">
    <div class="seg">
      <a href={url('statistikk/')} aria-current={sesong === null ? 'page' : undefined}>Alle tider</a>
      {db.sesonger.map((s) => <a href={url(`statistikk/${s}/`)} aria-current={sesong === s ? 'page' : undefined}>{s}</a>)}
    </div>
  </nav>

  <section class="mt-5" aria-labelledby="laget">
    <h2 id="laget" class="h-section mb-2">Laget</h2>
    <div class="grid grid-cols-4 gap-2 sm:grid-cols-8">
      {
        (
          [
            ['Kamper', lag.kamper],
            ['Seire', lag.seire],
            ['Uavgjort', lag.uavgjort],
            ['Tap', lag.tap],
            ['Mål for', lag.malFor],
            ['Mål mot', lag.malMot],
            ['Poeng', lag.poeng],
            ['Seier %', prosent(lag.kamper ? (lag.seire / lag.kamper) * 100 : null)],
          ] as const
        ).map(([label, v]) => (
          <div class="card px-2 py-3 text-center">
            <div class="num text-xl font-extrabold">{typeof v === 'number' ? v : v}</div>
            <div class="text-[0.7rem] font-medium text-muted">{label}</div>
          </div>
        ))
      }
    </div>
    {
      !sesong && sesongRader.length > 1 && (
        <div class="card mt-3 overflow-x-auto">
          <table class="tbl">
            <thead>
              <tr>
                <th scope="col">Sesong</th>
                <th scope="col" class="r">K</th>
                <th scope="col" class="r">S</th>
                <th scope="col" class="r">U</th>
                <th scope="col" class="r">T</th>
                <th scope="col" class="r">Mål</th>
                <th scope="col" class="r">+/-</th>
                <th scope="col" class="r">Poeng</th>
                <th scope="col" class="r" title="Gule kort">Gule</th>
                <th scope="col" class="r" title="Røde kort">Røde</th>
              </tr>
            </thead>
            <tbody>
              {sesongRader.map(({ s, st }) => (
                <tr>
                  <td><a class="link font-semibold" href={url(`statistikk/${s}/`)}>{s}</a></td>
                  <td class="r">{st.kamper}</td>
                  <td class="r">{st.seire}</td>
                  <td class="r">{st.uavgjort}</td>
                  <td class="r">{st.tap}</td>
                  <td class="r">{st.malFor}–{st.malMot}</td>
                  <td class="r">{st.malforskjell > 0 ? `+${st.malforskjell}` : st.malforskjell}</td>
                  <td class="r font-bold">{st.poeng}</td>
                  <td class="r">{st.gule}</td>
                  <td class="r">{st.rode}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )
    }
  </section>

  <div class="mt-6 grid gap-5 lg:grid-cols-2">
    <Toppliste
      id="toppscorere"
      tittel="Toppscorere"
      rader={scorere}
      tom="Ingen mål registrert."
      kolonner={[
        { label: 'Kamper', title: 'Kamper i troppen', verdi: (r) => r.stat.kamper },
        { label: 'Mål/kamp', verdi: (r) => tall(r.stat.mal / r.stat.kamper, 2) },
        { label: 'Mål', verdi: (r) => r.stat.mal, fet: true },
      ]}
    />
    <Toppliste
      id="flest-kamper"
      tittel="Flest kamper"
      rader={flestKamper}
      kolonner={[
        { label: 'Start', verdi: (r) => r.stat.startet },
        { label: 'Innb.', title: 'I troppen som innbytter', verdi: (r) => r.stat.innbytter },
        { label: 'Kamper', title: 'Kamper i troppen', verdi: (r) => r.stat.kamper, fet: true },
      ]}
      merknad="Kamper i troppen. Innbyttere er alltid krysset av som spilt, så vi vet ikke om alle kom inn."
    />
    <Toppliste
      id="gule"
      tittel="Flest gule kort"
      rader={gule}
      tom="Ingen gule kort."
      kolonner={[
        { label: 'Kamper', verdi: (r) => r.stat.kamper },
        { label: 'Gule', verdi: (r) => r.stat.gule, fet: true },
      ]}
    />
    <Toppliste
      id="rode"
      tittel="Flest røde kort"
      rader={rode}
      tom="Ingen røde kort."
      kolonner={[
        { label: '2 gule', title: 'Rødt etter to gule (Utv. Adv. 2)', verdi: (r) => r.stat.rodeAdv2 },
        { label: 'Direkte', title: 'Direkte rødt (Utv. Direkte)', verdi: (r) => r.stat.rodeDirekte },
        { label: 'Totalt', verdi: (r) => r.stat.rode, fet: true },
      ]}
    />
    <div class="lg:col-span-2">
      <Toppliste
        id="disiplin"
        tittel="Disiplinærtabell"
        rader={disiplin}
        tom="Ingen kort."
        antall={15}
        kolonner={[
          { label: 'Kamper', verdi: (r) => r.stat.kamper },
          { label: 'Gule', verdi: (r) => r.stat.gule },
          { label: 'Røde', verdi: (r) => r.stat.rode },
          { label: 'Kort/kamp', verdi: (r) => tall(r.verdi, 2), fet: true },
        ]}
        merknad={`Kort per kamp i troppen${minKamper > 1 ? `, minst ${minKamper} kamper` : ''}. Laget samlet: ${lag.kamper ? tall((lag.gule + lag.rode) / lag.kamper, 2) : '–'} kort per kamp.`}
      />
    </div>
  </div>
</Layout>
