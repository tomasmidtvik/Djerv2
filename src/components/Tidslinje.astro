---
// Hendelser i kronologisk rekkefølge. Hjemmelaget til venstre, bortelaget til høyre.
import type { Kamp, KampHendelse } from '../lib/db.ts';
import { spillerUrl } from '../lib/site.ts';
import Icon from './Icon.astro';
import Kort from './Kort.astro';
interface Props {
  kamp: Kamp;
}
const { kamp: k } = Astro.props;
const forste = k.hendelser.filter((e) => e.minutt !== null && e.minutt <= 45);
const andre = k.hendelser.filter((e) => e.minutt === null || e.minutt > 45);
const typeTekst = (e: KampHendelse) =>
  e.type === 'mal' ? (e.selvmal ? 'Selvmål' : 'Mål') : e.type === 'gult' ? 'Gult kort' : e.type === 'rodt2' ? 'Rødt kort (to gule)' : 'Rødt kort';
---

{
  k.hendelser.length === 0 ? (
    <p class="text-sm text-muted">Ingen mål eller kort i kampen.</p>
  ) : (
    <ol class="relative text-sm" aria-label="Hendelser i kampen">
      {[forste, andre].map((del, i) => (
        <>
          {i === 1 && k.pause && (
            <li class="my-2 flex items-center gap-3 text-xs font-semibold uppercase tracking-wide text-muted" aria-label={`Pause ${k.pause.hjemme}-${k.pause.borte}`}>
              <span class="h-px flex-1 bg-line" />
              Pause {k.pause.hjemme}–{k.pause.borte}
              <span class="h-px flex-1 bg-line" />
            </li>
          )}
          {del.map((e) => {
            const navn = e.navn ?? 'Ukjent målscorer';
            const innhold = (
              <span class={`inline-flex min-w-0 items-center gap-2 ${e.side === 'hjemme' ? 'flex-row-reverse text-right' : ''}`}>
                <span class="shrink-0">
                  {e.type === 'mal' ? <Icon name="ball" class="h-[18px] w-[18px]" label={typeTekst(e)} /> : <Kort type={e.type} />}
                </span>
                <span class="min-w-0">
                  <span class={`${e.type === 'mal' ? 'font-semibold' : ''} ${e.navn ? '' : 'italic text-muted'}`}>
                    {e.slug ? <a class="link text-ink" href={spillerUrl(e.slug)}>{navn}</a> : navn}
                  </span>
                  {e.selvmal && <span class="text-muted"> (selvmål)</span>}
                  {e.leder && <span class="text-muted"> (leder)</span>}
                </span>
              </span>
            );
            return (
              <li class="grid grid-cols-[1fr_3rem_1fr] items-center gap-2 py-1.5">
                <span class="flex justify-end">{e.side === 'hjemme' && innhold}</span>
                <span class="mx-auto flex flex-col items-center">
                  <span class={`num rounded-full px-2 py-0.5 text-center text-xs font-bold ring-1 ${e.type === 'mal' ? 'bg-accent text-on-accent ring-accent' : 'bg-surface-2 text-muted ring-line'}`}>
                    {e.minutt === null ? '?' : `${e.minutt}'`}
                  </span>
                  {e.stilling && <span class="num mt-0.5 text-[0.7rem] font-bold" aria-label={`Stilling ${e.stilling[0]}-${e.stilling[1]}`}>{e.stilling[0]}–{e.stilling[1]}</span>}
                </span>
                <span class="flex justify-start">{e.side === 'borte' && innhold}</span>
              </li>
            );
          })}
        </>
      ))}
      <li class="mt-2 flex items-center gap-3 text-xs font-semibold uppercase tracking-wide text-muted">
        <span class="h-px flex-1 bg-line" />
        Slutt {k.resultat.hjemme}–{k.resultat.borte}
        <span class="h-px flex-1 bg-line" />
      </li>
    </ol>
  )
}
