---
import Bane from '../../components/Bane.astro';
import Icon from '../../components/Icon.astro';
import KampFigurer from '../../components/KampFigurer.astro';
import Opptak from '../../components/Opptak.astro';
import Tidslinje from '../../components/Tidslinje.astro';
import Tropp from '../../components/Tropp.astro';
import Utfall from '../../components/Utfall.astro';
import Layout from '../../layouts/Layout.astro';
import { kampFakta } from '../../lib/analyse.ts';
import type { Kamp } from '../../lib/db.ts';
import { datoKort, datoLang, getDb, kampTittel, kampUrl, spillerUrl, stor, url } from '../../lib/site.ts';

export function getStaticPaths() {
  return getDb().kamper.map((kamp) => ({ params: { kampnr: kamp.kampnr } }));
}
// Hent kampen på nytt (ikke via props), så endringer i data/ vises uten omstart under "npm run dev"
const db = getDb();
const k: Kamp | undefined = db.kampMap.get(Astro.params.kampnr!);
if (!k) return Astro.redirect(url('kamper/'));
const forrige = k.forrige ? db.kampMap.get(k.forrige)! : null;
const neste = k.neste ? db.kampMap.get(k.neste)! : null;

// Målscorere per lag (kompakt under resultatet)
const scorere = (side: 'hjemme' | 'borte') => {
  const map = new Map<string, { navn: string; slug: string | null; min: string[] }>();
  for (const e of k.hendelser) {
    if (e.type !== 'mal' || e.side !== side) continue;
    const key = e.navn ?? '?';
    if (!map.has(key)) map.set(key, { navn: e.navn ?? 'Ukjent', slug: e.slug, min: [] });
    map.get(key)!.min.push(`${e.minutt ?? '?'}'${e.selvmal ? ' (s.m.)' : ''}`);
  }
  return [...map.values()];
};
const info: [string, string | null][] = [
  ['Dato', datoLang(k.dato)],
  ['Avspark', k.avspark],
  ['Bane', k.bane],
  ['Turnering', k.turnering],
  ['Dommer', k.dommer ? `${k.dommer.navn}${k.dommer.klubb ? ` (${k.dommer.klubb})` : ''}` : null],
  ['Dommerveileder', k.dommerveileder ? `${k.dommerveileder.navn}${k.dommerveileder.klubb ? ` (${k.dommerveileder.klubb})` : ''}` : null],
  ['Tilskuere', k.tilskuere && k.tilskuere > 0 ? String(k.tilskuere) : null],
  ['Ekstraomganger', k.eeo],
  ['Straffekonkurranse', k.straffekonk],
  ['Keeper', k.keeper?.kilde === 'metadata' ? k.keeper.navn : null],
  ['Protest', k.protester.length ? k.protester.map((p) => `${p.lag}, ${p.naar === 'for' ? 'før kampstart' : 'etter kampslutt'}`).join('; ') : null],
  ['Kampnr.', k.kampnr],
];
const ossLag = k.side === 'hjemme' ? k.hjemme : k.borte;
const f = kampFakta(k);
const malTekst = (e: typeof f.forste) => (e ? `${e.minutt}' ${e.navn ?? 'Ukjent'}${e.selvmal ? ' (selvmål)' : ''}` : null);
const fakta: [string, string | number | null][] = [
  ['Mål i kampen', f.totalt],
  ['Seiersmargin', f.margin || null],
  ['1. omgang (oss–dem)', `${f.malOmgang.for[0]}–${f.malOmgang.mot[0]}`],
  ['2. omgang (oss–dem)', `${f.malOmgang.for[1]}–${f.malOmgang.mot[1]}`],
  ['Første mål', malTekst(f.forste)],
  ['Siste mål', f.totalt > 1 ? malTekst(f.siste) : null],
  ['Ulike målscorere', f.ulikeScorere || null],
  ['Hat-trick', f.hatTricks.length ? f.hatTricks.map((s) => `${s.navn} (${s.mal.length})`).join(', ') : null],
  ['Mål etter posisjon', f.perPosisjon.length ? f.perPosisjon.map(([p, n]) => `${p} ${n}`).join(' · ') : null],
  ['Mål per 15 min (oss–dem)', f.totalt ? f.bolker.map((b) => `${b.for}–${b.mot}`).join(' · ') : null],
];
const harBane = k.hjemme.harMedia || k.borte.harMedia;
const beskrivelse = `${kampTittel(k)} (pause ${k.pause ? `${k.pause.hjemme}-${k.pause.borte}` : '–'}), ${datoKort(k.dato)} på ${k.bane}.`;
---

<Layout title={`${k.hjemme.navn} – ${k.borte.navn} ${k.resultat.hjemme}-${k.resultat.borte}`} description={beskrivelse} aktiv="kamper">
  <nav class="mb-3 text-sm text-muted" aria-label="Brødsmuler">
    <a href={url('kamper/')} class="link">Kamper</a>
    <span aria-hidden="true"> › </span>
    <a href={url(`kamper/?sesong=${k.sesong}`)} class="link">{k.sesong}</a>
  </nav>

  <!-- Resultattavle -->
  <section class="card overflow-hidden" aria-label="Resultat">
    <div class="bg-header px-4 pb-5 pt-4 text-header-ink">
      <p class="text-center text-xs font-medium opacity-80">{k.turnering} · {stor(datoLang(k.dato))} kl. {k.avspark}</p>
      <div class="mt-3 grid grid-cols-[1fr_auto_1fr] items-center gap-3">
        <h1 class={`text-right text-lg font-bold leading-tight sm:text-2xl ${k.side === 'hjemme' ? '' : 'opacity-90'}`}>{k.hjemme.navn}</h1>
        <div class="text-center">
          <div class="num text-4xl font-extrabold tracking-tight sm:text-5xl" aria-label={`${k.resultat.hjemme} mot ${k.resultat.borte}`}>
            {k.resultat.hjemme}<span class="mx-1 opacity-60">–</span>{k.resultat.borte}
          </div>
          {k.pause && <div class="num text-xs opacity-80">Pause {k.pause.hjemme}–{k.pause.borte}</div>}
        </div>
        <p class={`text-lg font-bold leading-tight sm:text-2xl ${k.side === 'borte' ? '' : 'opacity-90'}`}>{k.borte.navn}</p>
      </div>
      <div class="mt-3 grid grid-cols-2 gap-4 text-xs opacity-90">
        {(['hjemme', 'borte'] as const).map((side) => (
          <ul class={side === 'hjemme' ? 'text-right' : ''}>
            {scorere(side).map((s) => (
              <li>
                {s.slug ? <a href={spillerUrl(s.slug)} class="underline-offset-2 hover:underline">{s.navn}</a> : s.navn} <span class="num opacity-80">{s.min.join(', ')}</span>
              </li>
            ))}
          </ul>
        ))}
      </div>
    </div>
    <div class="flex items-center justify-center gap-2 px-4 py-2.5 text-sm">
      <Utfall utfall={k.utfall} size="md" />
      <span class="text-muted">for {ossLag.navn} · {k.side === 'hjemme' ? 'hjemmekamp' : 'bortekamp'} mot {k.motstander}</span>
    </div>
  </section>

  <div class="mt-5 grid gap-5 md:grid-cols-[minmax(0,1fr)_minmax(0,22rem)]">
    <div class="space-y-5">
      {
        k.opptak.length > 0 && (
          <section class="card p-4" aria-labelledby="opptak">
            <h2 id="opptak" class="h-section mb-3">Opptak</h2>
            <Opptak opptak={k.opptak} />
          </section>
        )
      }

      <section class="card p-4" aria-labelledby="hendelser">
        <h2 id="hendelser" class="h-section mb-2">Hendelser</h2>
        <div class="mb-2 grid grid-cols-[1fr_3rem_1fr] gap-2 text-xs font-semibold text-muted">
          <span class="truncate text-right">{k.hjemme.navn}</span><span></span><span class="truncate">{k.borte.navn}</span>
        </div>
        <Tidslinje kamp={k} />
        {
          (k.ukjenteMal.hjemme > 0 || k.ukjenteMal.borte > 0) && (
            <p class="mt-3 rounded-lg bg-draw-soft px-3 py-2 text-xs text-ink">
              Rapporten mangler målscorer for {k.ukjenteMal.hjemme + k.ukjenteMal.borte} mål (kanskje selvmål). Målet er ikke tildelt noen spiller.
            </p>
          )
        }
      </section>

      <KampFigurer kamp={k} />

      {
        k.referat && (
          <section class="card p-4" aria-labelledby="referat">
            <h2 id="referat" class="h-section mb-2">Kampreferat</h2>
            <div class="space-y-3 text-[0.95rem] leading-relaxed">
              {k.referat.split(/\n\s*\n/).map((p) => <p>{p}</p>)}
            </div>
          </section>
        )
      }

      <section aria-labelledby="oppstillinger">
        <h2 id="oppstillinger" class="h-section mb-3">Lagoppstillinger</h2>
        <div class="grid gap-4 lg:grid-cols-2">
          <Tropp lag={k.hjemme} side="Hjemme" />
          <Tropp lag={k.borte} side="Borte" />
        </div>
      </section>
    </div>

    <aside class="space-y-5">
      {
        harBane && (
          <section class="card p-4" aria-labelledby="banen">
            <h2 id="banen" class="h-section mb-3">Oppstilling</h2>
            <Bane kamp={k} />
          </section>
        )
      }
      <section class="card p-4" aria-labelledby="kampfakta">
        <h2 id="kampfakta" class="h-section mb-2">Kampfakta</h2>
        <dl class="divide-y divide-line text-sm">
          {
            fakta
              .filter(([, v]) => v !== null)
              .map(([label, v]) => (
                <div class="flex justify-between gap-4 py-2">
                  <dt class="text-muted">{label}</dt>
                  <dd class="num text-right">{v}</dd>
                </div>
              ))
          }
        </dl>
        {!k.malKomplett && <p class="mt-2 text-xs text-muted">Rapporten mangler minutt for {k.ukjenteMal.hjemme + k.ukjenteMal.borte} mål, så tallene er ufullstendige.</p>}
      </section>
      <section class="card p-4" aria-labelledby="kampinfo">
        <h2 id="kampinfo" class="h-section mb-2">Kampinfo</h2>
        <dl class="divide-y divide-line text-sm">
          {
            info
              .filter(([, v]) => v)
              .map(([label, v]) => (
                <div class="flex justify-between gap-4 py-2">
                  <dt class="text-muted">{label}</dt>
                  <dd class="text-right first-letter:uppercase">{v}</dd>
                </div>
              ))
          }
        </dl>
      </section>
    </aside>
  </div>

  <nav class="mt-6 grid grid-cols-2 gap-3" aria-label="Forrige og neste kamp">
    {
      forrige ? (
        <a href={kampUrl(forrige.kampnr)} class="card flex items-center gap-2 p-3 text-sm hover:border-accent">
          <Icon name="pil-venstre" class="h-5 w-5 shrink-0 text-muted" />
          <span class="min-w-0">
            <span class="block text-xs text-muted">Forrige kamp · {datoKort(forrige.dato)}</span>
            <span class="block truncate font-semibold">{kampTittel(forrige)}</span>
          </span>
        </a>
      ) : (
        <span />
      )
    }
    {
      neste && (
        <a href={kampUrl(neste.kampnr)} class="card flex items-center justify-end gap-2 p-3 text-right text-sm hover:border-accent">
          <span class="min-w-0">
            <span class="block text-xs text-muted">Neste kamp · {datoKort(neste.dato)}</span>
            <span class="block truncate font-semibold">{kampTittel(neste)}</span>
          </span>
          <Icon name="pil-hoyre" class="h-5 w-5 shrink-0 text-muted" />
        </a>
      )
    }
  </nav>
</Layout>
