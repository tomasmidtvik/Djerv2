---
import KampRad from '../../components/KampRad.astro';
import Layout from '../../layouts/Layout.astro';
import { slugify } from '../../lib/names.ts';
import { getDb } from '../../lib/site.ts';

const db = getDb();
const sesonger = db.sesonger;
const motstandere = [...new Map(db.kamper.map((k) => [slugify(k.motstander), k.motstander])).entries()].sort((a, b) =>
  a[1].localeCompare(b[1], 'nb'),
);
---

<Layout title="Kamper" description={`Alle kamper for ${db.settings.lagnavn}, sesong for sesong.`} aktiv="kamper">
  <h1 class="text-2xl font-bold tracking-tight">Kamper</h1>

  <form id="filter" class="mt-4 flex flex-wrap items-end gap-3" aria-label="Filtrer kamper" onsubmit="return false">
    <label class="flex flex-col gap-1 text-xs font-semibold text-muted">
      Sesong
      <select name="sesong" class="field">
        {sesonger.map((s) => <option value={s}>{s}</option>)}
        <option value="alle">Alle sesonger</option>
      </select>
    </label>
    <label class="flex flex-col gap-1 text-xs font-semibold text-muted">
      Motstander
      <select name="motstander" class="field max-w-[14rem]">
        <option value="">Alle motstandere</option>
        {motstandere.map(([slug, navn]) => <option value={slug}>{navn}</option>)}
      </select>
    </label>
    <div class="flex flex-col gap-1 text-xs font-semibold text-muted">
      <span id="lbl-utfall">Resultat</span>
      <div class="seg" role="group" aria-labelledby="lbl-utfall" data-name="utfall">
        <button type="button" data-v="" aria-pressed="true">Alle</button>
        <button type="button" data-v="S" aria-pressed="false">Seier</button>
        <button type="button" data-v="U" aria-pressed="false">Uavgj.</button>
        <button type="button" data-v="T" aria-pressed="false">Tap</button>
      </div>
    </div>
    <div class="flex flex-col gap-1 text-xs font-semibold text-muted">
      <span id="lbl-sted">Hjemme/borte</span>
      <div class="seg" role="group" aria-labelledby="lbl-sted" data-name="sted">
        <button type="button" data-v="" aria-pressed="true">Alle</button>
        <button type="button" data-v="hjemme" aria-pressed="false">Hjemme</button>
        <button type="button" data-v="borte" aria-pressed="false">Borte</button>
      </div>
    </div>
  </form>

  <p id="oppsummering" class="mt-4 text-sm text-muted" aria-live="polite"></p>

  <div class="mt-3 space-y-5">
    {
      sesonger.map((s) => {
        const kamper = db.kamper.filter((k) => k.sesong === s);
        return (
          <section data-gruppe={s} aria-labelledby={`sesong-${s}`}>
            <h2 id={`sesong-${s}`} class="mb-2 flex items-baseline justify-between">
              <span class="h-section">Sesong {s}</span>
              <span class="text-xs text-muted">{[...new Set(kamper.map((k) => k.turnering))].join(' · ')}</span>
            </h2>
            <ul class="card divide-y divide-line overflow-hidden">
              {kamper.map((k) => (
                <li
                  data-sesong={k.sesong}
                  data-utfall={k.utfall}
                  data-sted={k.side}
                  data-motstander={slugify(k.motstander)}
                  data-for={k.malFor}
                  data-mot={k.malMot}
                >
                  <KampRad kamp={k} />
                </li>
              ))}
            </ul>
          </section>
        );
      })
    }
    {db.kamper.length === 0 && <p class="text-muted">Ingen kamper er importert ennå.</p>}
    <p id="ingen" class="card hidden p-6 text-center text-muted">Ingen kamper passer filteret.</p>
  </div>
</Layout>

<script>
  const form = document.getElementById('filter') as HTMLFormElement;
  const sesongSel = form.elements.namedItem('sesong') as HTMLSelectElement;
  const motSel = form.elements.namedItem('motstander') as HTMLSelectElement;
  const segs = [...form.querySelectorAll<HTMLElement>('.seg')];
  const rows = [...document.querySelectorAll<HTMLElement>('li[data-sesong]')];
  const groups = [...document.querySelectorAll<HTMLElement>('[data-gruppe]')];
  const summary = document.getElementById('oppsummering')!;
  const ingen = document.getElementById('ingen')!;

  const segValue = (name: string) =>
    segs.find((s) => s.dataset.name === name)?.querySelector<HTMLElement>('[aria-pressed="true"]')?.dataset.v ?? '';
  const setSeg = (name: string, v: string) => {
    const seg = segs.find((s) => s.dataset.name === name);
    seg?.querySelectorAll<HTMLElement>('button').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.v === v)));
  };

  // Les filter fra URL-en (delbare lenker)
  const params = new URLSearchParams(location.search);
  const ps = params.get('sesong');
  if (ps && [...sesongSel.options].some((o) => o.value === ps)) sesongSel.value = ps;
  if (params.get('motstander')) {
    motSel.value = params.get('motstander')!;
    if (!ps) sesongSel.value = 'alle';
  }
  setSeg('utfall', params.get('resultat') ?? '');
  setSeg('sted', params.get('sted') ?? '');

  function apply() {
    const f = { sesong: sesongSel.value, motstander: motSel.value, utfall: segValue('utfall'), sted: segValue('sted') };
    let n = 0, s = 0, u = 0, t = 0, mf = 0, mm = 0;
    for (const r of rows) {
      const d = r.dataset;
      const show =
        (f.sesong === 'alle' || d.sesong === f.sesong) &&
        (!f.motstander || d.motstander === f.motstander) &&
        (!f.utfall || d.utfall === f.utfall) &&
        (!f.sted || d.sted === f.sted);
      r.hidden = !show;
      if (show) {
        n++;
        if (d.utfall === 'S') s++;
        else if (d.utfall === 'U') u++;
        else t++;
        mf += Number(d.for);
        mm += Number(d.mot);
      }
    }
    for (const g of groups) g.hidden = !g.querySelector('li[data-sesong]:not([hidden])');
    ingen.hidden = n > 0;
    ingen.classList.toggle('hidden', n > 0);
    summary.textContent = n
      ? `${n} ${n === 1 ? 'kamp' : 'kamper'} · ${s} seier${s === 1 ? '' : 'e'}, ${u} uavgjort, ${t} tap · mål ${mf}–${mm}`
      : '';
    const q = new URLSearchParams();
    if (f.sesong !== sesongSel.options[0].value) q.set('sesong', f.sesong);
    if (f.motstander) q.set('motstander', f.motstander);
    if (f.utfall) q.set('resultat', f.utfall);
    if (f.sted) q.set('sted', f.sted);
    history.replaceState(null, '', q.size ? `?${q}` : location.pathname);
  }

  form.addEventListener('change', apply);
  for (const seg of segs) {
    seg.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest('button');
      if (!b) return;
      setSeg(seg.dataset.name!, b.dataset.v ?? '');
      apply();
    });
  }
  apply();
</script>
