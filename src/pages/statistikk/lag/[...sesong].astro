---
import BilanseTabell from '../../../components/BilanseTabell.astro';
import StatSeksjon from '../../../components/StatSeksjon.astro';
import Tall from '../../../components/Tall.astro';
import Utfall from '../../../components/Utfall.astro';
import { bilanse, omganger, rekker, rekorder, resultatFordeling, sesongRader, type Rekke } from '../../../lib/analyse.ts';
import { datoKort, getDb, kampTittel, kampUrl, tall, url } from '../../../lib/site.ts';
import { tilKampData } from '../../../lib/maltid.ts';
import { kamperISesong } from '../../../lib/stats.ts';

export function getStaticPaths() {
  return [{ params: { sesong: undefined } }, ...getDb().sesonger.map((s) => ({ params: { sesong: String(s) } }))];
}
const sesong = Astro.params.sesong ? Number(Astro.params.sesong) : null;
const db = getDb();
const regel = db.settings.poeng;
const kamper = kamperISesong(db, sesong);
const json = JSON.stringify(kamper.map((k) => tilKampData(k, regel))).replace(/</g, '\\u003c');
const b = bilanse(kamper, regel);
const hjemme = bilanse(kamper.filter((k) => k.side === 'hjemme'), regel);
const borte = bilanse(kamper.filter((k) => k.side === 'borte'), regel);
const fordeling = resultatFordeling(kamper);
const o = omganger(kamper);
const r = rekker(kamper);
const rek = rekorder(kamper);
const cleanSheets = kamper.filter((k) => k.malMot === 0 && k.malKomplett).length;
const utenScoring = kamper.filter((k) => k.malFor === 0).length;
const maksFord = Math.max(1, ...fordeling.map((f) => f.antall));
const rekkeTekst = (x: Rekke) =>
  x.lengde && x.fra && x.til ? `${datoKort(x.fra.dato)}${x.lengde > 1 ? `–${datoKort(x.til.dato)}` : ''}${x.paagaar ? ' (pågår)' : ''}` : '';
const rekkeRader: [string, Rekke][] = [
  ['Seiersrekke', r.seier],
  ['Ubeseiret', r.ubeseiret],
  ['Tapsrekke', r.tap],
  ['Uten seier', r.utenSeier],
  ['Kamper på rad med scoring', r.scoring],
];
const rekordRader = [
  ['Største seier', rek.storsteSeier],
  ['Største tap', rek.storsteTap],
  ['Flest mål i en kamp', rek.flestMal],
  ['Flest mål scoret', rek.flestScoret],
  ['Flest mål sluppet inn', rek.flestSluppetInn],
] as const;
const minuttRader = [
  ['Raskeste mål', rek.raskesteMal],
  ['Seneste mål', rek.senesteMal],
  ['Raskeste baklengsmål', rek.raskesteBaklengs],
] as const;
---

<StatSeksjon seksjon="lag" tittel="Laget" sesong={sesong} beskrivelse={`Basert på ${kamper.length} av ${kamper.length} kamper. Poeng: ${regel.seier} for seier, ${regel.uavgjort} for uavgjort.`}>
  <Tall
    kolonner="grid-cols-4 sm:grid-cols-8"
    tall={[
      ['Kamper', b.kamper],
      ['Seire', b.seire],
      ['Uavgjort', b.uavgjort],
      ['Tap', b.tap],
      ['Poeng', b.poeng],
      ['Mål', `${b.malFor}–${b.malMot}`],
      ['Mål for/kamp', tall(b.malForSnitt ?? 0, 2)],
      ['Mål mot/kamp', tall(b.malMotSnitt ?? 0, 2)],
    ]}
  />

  <section class="card p-4" aria-labelledby="formkurve">
    <div class="flex flex-wrap items-center justify-between gap-2">
      <h2 id="formkurve" class="h-section">Form</h2>
      <span class="flex items-center gap-1.5 text-xs text-muted">
        Siste 5:
        {kamper.slice(-5).map((k) => <a href={kampUrl(k.kampnr)} title={kampTittel(k)}><Utfall utfall={k.utfall} /></a>)}
      </span>
    </div>
    {kamper.length >= 5 ? (
      <>
        <p class="mb-2 mt-1 text-sm text-muted">Snitt mål for og mot de siste fem kampene, gjennom {sesong ? 'sesongen' : 'hele arkivet'}.</p>
        <div id="rullerende-forklaring"></div>
        <div id="rullerende"></div>
      </>
    ) : (
      <p class="mt-1 text-sm text-muted">Ikke nok data: kurven vises fra 5 kamper.</p>
    )}
  </section>

  {
    !sesong && (
      <section class="grid gap-3 lg:grid-cols-2" aria-label="Sesongkurver">
        <div class="card min-w-0 p-4">
          <h2 class="font-semibold">Mål per kamp, per sesong</h2>
          <div id="sesong-mal-forklaring" class="mt-1"></div>
          <div id="sesong-mal"></div>
        </div>
        <div class="card min-w-0 p-4">
          <h2 class="font-semibold">Poeng per kamp, per sesong</h2>
          <div id="sesong-poeng"></div>
        </div>
      </section>
    )
  }

  <script type="application/json" id="lag-data" set:html={json}></script>

  <section aria-labelledby="hjemmeborte">
    <h2 id="hjemmeborte" class="h-section mb-2">Hjemme og borte</h2>
    <BilanseTabell forste="Sted" rader={[{ navn: 'Hjemme', b: hjemme }, { navn: 'Borte', b: borte }]} />
  </section>

  {
    !sesong && (
      <section aria-labelledby="sesonger">
        <h2 id="sesonger" class="h-section mb-2">Sesong for sesong</h2>
        <BilanseTabell
          forste="Sesong"
          rader={sesongRader(db).map((s) => ({
            navn: String(s.sesong),
            href: url(`statistikk/lag/${s.sesong}/`),
            merknad: `${s.turneringer.join(', ')}${s.rykk ? ` · ${s.rykk}` : ''}`,
            b: s.b,
          }))}
        />
      </section>
    )
  }

  <section aria-labelledby="omganger">
    <h2 id="omganger" class="h-section mb-2">Omganger</h2>
    <div class="grid gap-3 md:grid-cols-2">
      <div class="card overflow-x-auto">
        <table class="tbl">
          <caption class="px-3 pt-3 text-left text-sm font-semibold">Mål per omgang</caption>
          <thead><tr><th scope="col"></th><th scope="col" class="r">1. omgang</th><th scope="col" class="r">2. omgang</th></tr></thead>
          <tbody>
            <tr><th scope="row" class="!text-sm !normal-case !tracking-normal !text-ink">Mål for</th><td class="r">{o.for1}</td><td class="r">{o.for2}</td></tr>
            <tr><th scope="row" class="!text-sm !normal-case !tracking-normal !text-ink">Mål mot</th><td class="r">{o.mot1}</td><td class="r">{o.mot2}</td></tr>
          </tbody>
        </table>
        {o.utenOmgang > 0 && <p class="px-3 pb-3 pt-1 text-xs text-muted">{o.utenOmgang} mål mangler minutt i rapporten og er ikke med.</p>}
      </div>
      <div class="card overflow-x-auto">
        <table class="tbl">
          <caption class="px-3 pt-3 text-left text-sm font-semibold">Stilling til pause og utfall</caption>
          <thead><tr><th scope="col">Til pause</th><th scope="col" class="r">K</th><th scope="col" class="r">S</th><th scope="col" class="r">U</th><th scope="col" class="r">T</th></tr></thead>
          <tbody>
            {([['Ledet', o.pause.ledet], ['Likt', o.pause.likt], ['Bak', o.pause.bak]] as const).map(([n, x]) => (
              <tr><th scope="row" class="!text-sm !normal-case !tracking-normal !text-ink">{n}</th><td class="r">{x.kamper}</td><td class="r">{x.S}</td><td class="r">{x.U}</td><td class="r">{x.T}</td></tr>
            ))}
          </tbody>
        </table>
        <p class="px-3 pb-3 pt-1 text-xs text-muted">Basert på {o.grunnlag} av {kamper.length} kamper.</p>
      </div>
    </div>
    <div class="mt-3 grid gap-3 md:grid-cols-2">
      {([['Snuoperasjoner (bak til pause, ikke tap)', o.snu], ['Tapt pauseledelse', o.tapt]] as const).map(([tittel, liste]) => (
        <div class="card">
          <h3 class="border-b border-line px-4 py-2.5 text-sm font-semibold">{tittel}: {liste.length}</h3>
          <ul class="divide-y divide-line">
            {liste.slice(-6).reverse().map((k) => (
              <li><a href={kampUrl(k.kampnr)} class="flex items-center gap-3 px-4 py-2 text-sm hover:bg-surface-2"><Utfall utfall={k.utfall} /><span class="min-w-0 flex-1 truncate">{kampTittel(k)}</span><span class="num text-xs text-muted">{datoKort(k.dato)}</span></a></li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <section aria-labelledby="clean">
    <h2 id="clean" class="h-section mb-2">Clean sheets og rekker</h2>
    <Tall kolonner="grid-cols-2" tall={[['Clean sheets', cleanSheets, 'kamper uten baklengs'], ['Uten scoring', utenScoring, 'kamper uten egne mål']]} />
    <div class="card mt-3 overflow-x-auto">
      <table class="tbl">
        <thead><tr><th scope="col">Rekke</th><th scope="col" class="r">Kamper</th><th scope="col">Periode</th></tr></thead>
        <tbody>
          {rekkeRader.map(([n, x]) => (
            <tr><td class="font-medium">{n}</td><td class="r font-bold">{x.lengde}</td><td class="num whitespace-nowrap text-muted">{rekkeTekst(x)}</td></tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section aria-labelledby="rekorder">
    <h2 id="rekorder" class="h-section mb-2">Rekorder</h2>
    <div class="card divide-y divide-line">
      {rekordRader.map(([n, x]) => x && (
        <div class="flex items-start justify-between gap-4 px-4 py-2.5 text-sm">
          <span class="text-muted">{n}</span>
          <span class="text-right">{x.kamper.slice(0, 3).map((k) => <a class="link block" href={kampUrl(k.kampnr)}>{kampTittel(k)} <span class="num text-xs text-muted">{datoKort(k.dato)}</span></a>)}</span>
        </div>
      ))}
      {minuttRader.map(([n, x]) => x && (
        <div class="flex items-start justify-between gap-4 px-4 py-2.5 text-sm">
          <span class="text-muted">{n}</span>
          <a class="link text-right" href={kampUrl(x.k.kampnr)}><span class="font-semibold">{x.e.minutt}'</span> {x.e.navn ?? ''}{x.e.selvmal ? ' (selvmål)' : ''} <span class="num block text-xs text-muted">{kampTittel(x.k)}, {datoKort(x.k.dato)}</span></a>
        </div>
      ))}
    </div>
  </section>

  <section aria-labelledby="fordeling">
    <h2 id="fordeling" class="h-section mb-2">Resultatfordeling</h2>
    <p class="mb-2 text-sm text-muted">Fra vårt ståsted: egne mål først.{fordeling[0] && ` Vanligste resultat er ${fordeling[0].resultat} (${fordeling[0].antall} ${fordeling[0].antall === 1 ? 'gang' : 'ganger'}).`}</p>
    <ul class="card divide-y divide-line">
      {fordeling.map((f) => (
        <li class="flex items-center gap-3 px-4 py-1.5 text-sm">
          <span class="num w-12 font-semibold">{f.resultat}</span>
          <span class="flex-1"><span class={`block h-2.5 rounded ${f.utfall === 'S' ? 'bg-win' : f.utfall === 'U' ? 'bg-draw' : 'bg-loss'}`} style={`width:${Math.max(4, (f.antall / maksFord) * 100)}%`}></span></span>
          <span class="num w-6 text-right text-muted">{f.antall}</span>
        </li>
      ))}
    </ul>
  </section>
</StatSeksjon>

<script>
  import { rullerende, sesongKurver } from '../../../lib/figurdata.ts';
  import { datoTekst, FARGE, forklaring, linjediagram, tallTekst, vedResize } from '../../../lib/figurer.ts';
  import type { KampData } from '../../../lib/maltid.ts';

  const data = JSON.parse(document.getElementById('lag-data')!.textContent!) as KampData[];
  const $ = (id: string) => document.getElementById(id);
  const toppen = (maks: number) => Math.max(1, Math.ceil(maks));

  function tegnRullerende() {
    const el = $('rullerende');
    if (!el) return;
    const r = rullerende(data, 5);
    forklaring($('rullerende-forklaring')!, [
      { navn: 'Mål for', farge: FARGE.for, form: 'strek' },
      { navn: 'Mål mot', farge: FARGE.mot, form: 'strek' },
    ]);
    const maks = toppen(Math.max(...r.flatMap((x) => [x.for, x.mot])));
    const sesonger = [...new Set(data.map((d) => d.sesong))];
    const xTicks =
      sesonger.length > 1
        ? sesonger.flatMap((s) => {
            const p = r.find((x) => x.kamp.sesong === s);
            return p ? [{ x: p.i, tekst: String(s) }] : [];
          })
        : r.filter((_, i) => i % 3 === 0).map((x) => ({ x: x.i, tekst: `${x.kamp.dato.slice(8, 10)}.${x.kamp.dato.slice(5, 7)}` }));
    linjediagram(el, {
      etikett: `Rullerende snitt over fem kamper. Siste verdi er ${tallTekst(r.at(-1)?.for ?? 0)} mål for og ${tallTekst(r.at(-1)?.mot ?? 0)} mål mot per kamp.`,
      serier: [
        { navn: 'Mål for', farge: FARGE.for, punkter: r.map((x) => ({ x: x.i, y: x.for })) },
        { navn: 'Mål mot', farge: FARGE.mot, punkter: r.map((x) => ({ x: x.i, y: x.mot })) },
      ],
      xMin: r[0]?.i ?? 0,
      xMaks: r.at(-1)?.i ?? 1,
      yMin: 0,
      yMaks: maks,
      xTicks,
      yTicks: Array.from({ length: maks + 1 }, (_, y) => ({ y, tekst: String(y) })),
      xTekst: (x) => {
        const p = r.find((k) => k.i === x);
        return p ? `${p.kamp.tittel}, ${datoTekst(p.kamp.dato)}` : '';
      },
      yTekst: (y) => tallTekst(y),
    });
  }

  function tegnSesong() {
    const a = $('sesong-mal');
    const b = $('sesong-poeng');
    if (!a || !b) return;
    const k = sesongKurver(data);
    const xTicks = k.map((x) => ({ x: x.sesong, tekst: String(x.sesong) }));
    const felles = { xMin: k[0].sesong, xMaks: k.at(-1)!.sesong, xTicks, xTekst: (x: number) => `Sesong ${x}`, yTekst: (y: number) => tallTekst(y, 2), yMin: 0, hoyde: 210 };
    forklaring($('sesong-mal-forklaring')!, [
      { navn: 'Mål for', farge: FARGE.for, form: 'strek' },
      { navn: 'Mål mot', farge: FARGE.mot, form: 'strek' },
    ]);
    const maks = toppen(Math.max(...k.flatMap((x) => [x.malFor, x.malMot])));
    linjediagram(a, {
      ...felles,
      etikett: `Mål for og mot per kamp per sesong. ${k.map((x) => `${x.sesong}: ${tallTekst(x.malFor, 2)} for og ${tallTekst(x.malMot, 2)} mot`).join('. ')}.`,
      serier: [
        { navn: 'Mål for', farge: FARGE.for, punkter: k.map((x) => ({ x: x.sesong, y: x.malFor })) },
        { navn: 'Mål mot', farge: FARGE.mot, punkter: k.map((x) => ({ x: x.sesong, y: x.malMot })) },
      ],
      yMaks: maks,
      yTicks: Array.from({ length: maks + 1 }, (_, y) => ({ y, tekst: String(y) })),
    });
    linjediagram(b, {
      ...felles,
      etikett: `Poeng per kamp per sesong. ${k.map((x) => `${x.sesong}: ${tallTekst(x.poeng, 2)}`).join('. ')}.`,
      serier: [{ navn: 'Poeng per kamp', farge: FARGE.for, punkter: k.map((x) => ({ x: x.sesong, y: x.poeng })) }],
      yMaks: 3,
      yTicks: [0, 1, 2, 3].map((y) => ({ y, tekst: String(y) })),
    });
  }

  const tegn = () => {
    tegnRullerende();
    tegnSesong();
  };
  tegn();
  const rot = $('rullerende') ?? $('sesong-mal');
  if (rot) vedResize(rot, tegn);
</script>
